# =============================================================================
# Mikovoice — Development Environment Variables
# =============================================================================
# Copy this file to .env.development and adjust values for your local setup.
# .env.development is gitignored — never commit it.
#
#   cp .env.example .env.development
#
# All VITE_* variables are statically inlined by Vite at build time.
# They are NOT present in production builds unless explicitly set during CI.
# =============================================================================

# -----------------------------------------------------------------------------
# Debug Flags
# -----------------------------------------------------------------------------

# Force the onboarding wizard to appear on every app launch.
# Useful when iterating on the onboarding UI.
# Set to false (or remove) when done debugging.
VITE_SHOW_ONBOARDING=false
